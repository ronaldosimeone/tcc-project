# ── Banco de Dados (Rede Docker) ──────────────────────────────────────
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=tcc_db
DATABASE_URL=postgresql+asyncpg://seu_usuario_aqui:sua_senha_segura_aqui@db:5432/tcc_db

# ── Machine Learning (RF-10 / RNF-09) ─────────────────────────────────
# Seleção do modelo ativo no contêiner — ver src/services/model_registry.py::KNOWN_MODELS
# Vencedor do benchmark RF-18/RNF-36 (apps/backend/benchmark_models.py) — não hardcode
# manualmente sem rodar `python benchmark_models.py` de novo.
ACTIVE_MODEL=random_forest_v2
# Estratégia de balanceamento do SMOTE
SMOTE_SAMPLING_STRATEGY=auto

# ── Infra / Load Test (RNF-37 / RNF-38) ────────────────────────────────
# Workers do Uvicorn no serviço `api` — requer recriar o container
# (`docker compose up -d --force-recreate api`). Ver locust_streaming.py.
UVICORN_WORKERS=1
# Pool de conexões SQLAlchemy/asyncpg (por worker) — src/core/database.py.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Configurações da API ──────────────────────────────────────────────
PROJECT_NAME="TCC Manutenção Preditiva"
VERSION="1.0.0"
ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]'

# RF-11 — token exigido por PUT /models/active e GET /models (header
# X-Admin-Token). Com o valor placeholder abaixo, src/core/auth.py trata
# como "modo dev" e NÃO exige o header. Troque para um valor real em
# qualquer ambiente que não seja a sua máquina de desenvolvimento.
ADMIN_API_TOKEN=change-me-in-production

# ── IA Local (Docker -> Host) — RF-22 / RNF-46 ──────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modelo usado por MaintenanceSuggestionService (POST /v1/maintenance/suggest).
OLLAMA_MODEL=llama3.2:3b
# Timeouts generosos — Llama 3.2 3B em CPU pode levar dezenas de segundos;
# a 1ª chamada ao MCP aciona o cold-start do SentenceTransformer (~30s).
OLLAMA_CLIENT_TIMEOUT_SECONDS=120.0
MCP_CLIENT_TIMEOUT_SECONDS=60.0

# ── Notificações críticas via Telegram (RF-24 / RNF-48) ─────────────────
# Deixe em branco para desativar (nenhuma tentativa de envio é feita —
# apenas logado como configuração ausente). Ver README "RF-24 — Criando o
# Bot do Telegram" para o passo a passo com o BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_CLIENT_TIMEOUT_SECONDS=10.0
# URL absoluta do Dashboard usada no link do alerta — NUNCA vem da predição/
# LLM (evita open redirect). Troque para o domínio real em produção.
DASHBOARD_URL=http://localhost
# Rate limit: 1 alerta crítico por equipamento a cada 900s (15 min).
CRITICAL_FAILURE_RATE_LIMIT_SECONDS=900
# O pipeline real hoje simula um único ativo — mesmo ID já usado na rota
# do frontend (/sensors/APU-Trem-042).
DEFAULT_EQUIPMENT_ID=APU-Trem-042
DEFAULT_EQUIPMENT_NAME="Compressor de Ar Industrial (MetroPT-3)"

# ── Notificações críticas via e-mail — Resend (RF-25 / RNF-49) ──────────
# Primeiro canal de e-mail do projeto (nenhuma integração existia antes).
# Deixe em branco para desativar (mesma regra do Telegram acima).
RESEND_API_KEY=
# Precisa ser um remetente de domínio verificado no Resend em produção.
RESEND_FROM_EMAIL="PredictIQ <alerts@predictiq.dev>"
RESEND_API_BASE_URL=https://api.resend.com
RESEND_CLIENT_TIMEOUT_SECONDS=10.0

# ── Fila assíncrona de notificações — Celery + Redis (RNF-50 / RNF-51) ──
# Broker do Celery — nome do serviço Redis no docker-compose.yml (não é
# alcançável fora da rede Docker interna). Consumida por
# src/core/celery_app.py; NUNCA hardcoded no código.
CELERY_BROKER_URL=redis://redis:6379/0

# ── MCP Server (RF-19 / RNF-43) ────────────────────────────────────────
# Serviço standalone (apps/mcp-server), container e processo próprios —
# ver docker-compose.yml::mcp-server e README "Arquitetura MCP".
# Porta do serviço mcp-server (streamable-http). Só crie/mude esta variável
# se precisar rodar mais de uma instância ou evitar conflito de porta.
MCP_SERVER_PORT=8100
# URL pela qual o serviço MCP é alcançável na rede Docker interna. O
# backend ainda NÃO consome esta variável nesta task — reservada para a
# integração futura (Ollama -> MCP -> search_maintenance_manual, RF-19).
MCP_SERVER_URL=http://mcp-server:8100

# ── Ingestão de manuais (RF-20 / RNF-44) ────────────────────────────────
# Pipeline apps/mcp-server/index_manuals.py — prepara a base de conhecimento
# em ChromaDB (collection "maintenance_manuals") que a ferramenta MCP
# `search_maintenance_manual` consumirá numa task futura. Ver README
# "RF-20 — Ingestão de manuais".
#
# Modelo de embeddings (sentence-transformers, 100% local, sem API externa).
# Default multilíngue (cobre português dos manuais e das queries).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Onde colocar os PDFs — relativo a apps/mcp-server/ (já é o volume do
# serviço mcp-server em docker-compose.yml, nenhum mount extra necessário).
MANUALS_DIR=data/manuals
# Onde o ChromaDB persiste os embeddings — mesma lógica de volume acima.
CHROMA_DB_PATH=data/chroma
# Tamanho do chunk (caracteres) e overlap entre chunks consecutivos da
# mesma página. Mesmo PDF + mesma config = mesmos chunks (determinístico).
CHUNK_SIZE=1000
CHUNK_OVERLAP=150